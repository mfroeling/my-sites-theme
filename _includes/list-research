{% comment %}
  List the pages that have both tag and grp in their tags.
  Example: {% include list-research tag='research' grp='metabolic' %}
{% endcomment %}
<ul class="page-list">
{% for p in site.pages %}{% if p.tags contains include.tag and p.tags contains include.grp %}
  <li><a href="{{ site.baseurl }}{{ p.url }}">{{ p.title }}</a></li>
{% endif %}{% endfor %}
</ul>
